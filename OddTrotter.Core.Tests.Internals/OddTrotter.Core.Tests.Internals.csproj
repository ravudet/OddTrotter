<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net7.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RootNamespace />
    <TreatWarningsAsErrors>True</TreatWarningsAsErrors>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>

    <DefineConstants>$(DefineConstants);OddTrotterCoreTestsInternal</DefineConstants>
    <TestImplementationMode>false</TestImplementationMode>
  </PropertyGroup>

  <ItemGroup Condition=" '$(TestImplementationMode)' == 'false' ">
    <Compile Remove="CalendarV2\System\ArgumentNullInlineCompilationTestResources\Play.cs" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\OddTrotter.Core\OddTrotter\CalendarV2\System\ArgumentNullInline.cs" Link="CalendarV2\System\ArgumentNullInline.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="CalendarV2\System\ArgumentNullInlineCompilationTestResources\Play.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="3.2.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="4.13.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.7.1" />
    <PackageReference Include="MSTest.TestAdapter" Version="2.2.10" />
    <PackageReference Include="MSTest.TestFramework" Version="2.2.10" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OddTrotter.Core\OddTrotter.Core.csproj">
      <Aliases>OddTrotterCore</Aliases>
    </ProjectReference>
  </ItemGroup>

</Project>
